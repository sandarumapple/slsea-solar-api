PORT=3000
MONGODB_URI="mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_CLUSTER_HOST/solar_generation?retryWrites=true&w=majority"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
NODE_ENV=development
# Required for all seed runs: a private random password of at least 16 characters.
# SEED_PASSWORD=choose-a-private-demo-password

# Local default 0. Render blueprint uses 1; match your actual proxy topology.
TRUST_PROXY_HOPS=0
